# Copy to .env and fill in. Never commit .env. Everything here is free.

# Option A: Google Gemini free tier (no credit card). Get a key at https://aistudio.google.com/apikey
# Leave blank to use Option B.
GEMINI_API_KEY=

# Option B: a local model through Ollama (no key, no account, data stays on your computer).
# Used automatically when GEMINI_API_KEY is blank. First run: ollama pull qwen3:8b
# OLLAMA_HOST=http://localhost:11434

# USDA FoodData Central for calorie data. Free key: https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works but is limited to about 30 lookups an hour.
USDA_API_KEY=DEMO_KEY

# Optional overrides
# FITNESS_PROVIDER=gemini | ollama | anthropic
# FITNESS_MODEL=gemini-3.8-flash   (or qwen3:8b for Ollama)
# FITNESS_DB=data/fitness.db
